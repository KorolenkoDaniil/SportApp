# Используем официальный образ Python (версию можно поменять, если нужна другая)
FROM python:3.10-slim

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем файл с зависимостями
COPY requirements.txt .

# Устанавливаем библиотеки
RUN pip install --no-cache-dir -r requirements.txt

# Копируем все остальные файлы проекта (main.py и прочие)
COPY . .

# Команда для запуска вашего приложения. 
# Если сервер запускается внутри main.py:
CMD ["python", "main.py"]

# ВАЖНО: Если вы используете FastAPI и Uvicorn, закомментируйте строку выше 
# и раскомментируйте строку ниже (порт 8000 совпадает с вашим .bat скриптом):
# CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]